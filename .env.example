# Copy to .env.local and fill in. Never commit .env.local.

# ── Required for the dashboard, contact form and newsletter ────────────────
# A Postgres connection string. On Neon, use the POOLED one (host ends -pooler).
# Without it the public site still works and the forms fall back to email.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Optional: connections per server instance (default 10). 3 suits serverless.
DATABASE_POOL_MAX=""

# ── Recommended ──────────────────────────────────────────────────────────────
# The live domain, used for canonical URLs, the sitemap and social cards.
NEXT_PUBLIC_SITE_URL="https://opeyemiojurongbe.vercel.app"

# Any long random string. Scrambles visitor IPs before rate limiting, so they
# are never stored. Generate one with:  openssl rand -base64 32
IP_HASH_SECRET=""

# ── Optional: an email alert for each new enquiry (via resend.com) ─────────
RESEND_API_KEY=""
NOTIFY_EMAIL=""
# A sender on a domain you have verified with Resend, e.g. "Website <hello@yourdomain.com>"
NOTIFY_FROM=""

# ── Optional: Google Search Console ownership token ────────────────────────
GOOGLE_SITE_VERIFICATION=""
